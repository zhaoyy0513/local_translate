# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Whisper 模型配置 (tiny/base/small/medium/large-v3)
# medium 准确率最高 (CPU 上运行较慢,但可接受)
# 如果太慢可以改回 small
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 音频配置
# 采样率必须与设备匹配 (24号设备是 48000 Hz)
SAMPLE_RATE=48000
# 每次处理的音频时长(秒)
# 更长 = 更准确但延迟更高 (推荐 5-8 秒)
CHUNK_DURATION=6

# 音频设备索引 (WASAPI 立体声混音 - 确认可用)
AUDIO_DEVICE_INDEX=24

# 翻译配置 (可选 - 如果不需要翻译，设置 ENABLE_TRANSLATION=false)
ENABLE_TRANSLATION=true
SOURCE_LANG=en
TARGET_LANG=zh-CN
